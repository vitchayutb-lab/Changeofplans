# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของคุณ  (cp .env.example .env)
# ทุกค่าเป็น optional — ถ้าไม่ตั้งค่าเลย ระบบจะรันในโหมดข้อมูลจำลองได้ทันที

# API key จาก CoinMarketCap (สมัครฟรีที่ https://coinmarketcap.com/api/)
# ถ้าใส่ค่านี้ ระบบจะดึง "ราคาล่าสุด" จริงมาใช้แทนข้อมูลจำลอง
CMC_API_KEY=

# API key ของ Anthropic สำหรับให้แชตบอทใช้ Claude เรียบเรียงคำตอบ
# ไม่ใส่ก็ได้ — แชตบอทจะตอบด้วยกฎในระบบซึ่งอ้างอิงข้อมูลชุดเดียวกัน
ANTHROPIC_API_KEY=

# เหรียญที่ต้องการติดตาม คั่นด้วยเครื่องหมายจุลภาค
MEME_SYMBOLS=DOGE,SHIB,PEPE,WIF,BONK,FLOKI

# จำนวนวันย้อนหลังที่ใช้คำนวณค่า Beta
HISTORY_DAYS=180

# สมมติฐานทางการเงิน (ตัวเลขทศนิยม เช่น 0.04 = 4% ต่อปี)
RISK_FREE_RATE=0.04
MARKET_EXPECTED_RETURN=0.35

# การจำลอง Monte Carlo
MC_PATHS=2000
MC_HORIZON_DAYS=30

# seed สำหรับข้อมูลจำลอง (ค่าเดิม = ผลลัพธ์เดิมทุกครั้ง)
RANDOM_SEED=20240614

# ═════════════════════════════════════════════════════════════════════════════
# SME Finance Copilot (apps/server) — คัดลอกเป็น .env ที่ root ของโปรเจกต์
# ทุกค่าเป็น optional: ถ้าไม่ใส่อะไรเลย ระบบจะรันใน DEMO MODE ได้ทันที
# ═════════════════════════════════════════════════════════════════════════════

# ── Bank of Thailand API (แหล่งข้อมูลการเงินหลักของระบบ) ──────────────────────
# สมัครใช้งานและ subscribe ชุดข้อมูลที่ต้องการได้ที่ https://portal.api.bot.or.th/
# ค่านี้ถูกอ่านเฉพาะฝั่งเซิร์ฟเวอร์เท่านั้น — ห้ามส่งไปที่เบราว์เซอร์เด็ดขาด
BOT_API_KEY=

# ที่อยู่ของเกตเวย์ — ใส่เฉพาะโฮสต์ ห้ามใส่ path ของ endpoint ต่อท้าย
#
# ธปท. ย้ายระบบ BOT API ไปพอร์ทัลใหม่เมื่อ 17 ก.ย. 2025 และปิดเกตเวย์เดิม
# (apigw1.bot.or.th) ไปแล้วเมื่อ 31 ธ.ค. 2025 โฮสต์เดิมจึงหาไม่เจอใน DNS อีกต่อไป
#
# เกตเวย์ของระบบใหม่คือ gateway.api.bot.or.th (ไม่ใช่ portal.api.bot.or.th ซึ่งเป็นเว็บไซต์)
# ตรวจกับเอกสาร API ของชุดข้อมูลที่คุณ subscribe อีกครั้งก่อนใช้
#
#   ✅ ถูก : https://gateway.api.bot.or.th
#   ❌ ผิด : https://gateway.api.bot.or.th/LoanRate/v2/loan_rate/   ← path จะซ้ำสองชั้น
#   ❌ ผิด : https://portal.api.bot.or.th                          ← เว็บไซต์ ไม่ใช่ API
#
# ระบบตรวจทั้งสามกรณีนี้ให้และบอกวิธีแก้ ถ้าไม่ตั้งค่าจะทำงานใน DEMO MODE
# ค่าเริ่มต้นคือ https://gateway.api.bot.or.th อยู่แล้ว ตั้งเองเมื่อต้องการชี้ไปที่อื่น
BOT_API_BASE_URL=https://gateway.api.bot.or.th

# ชื่อ header ที่ใช้ส่ง API key
# เกตเวย์ใหม่ใช้ Authorization โดยส่งโทเคนดิบ ไม่ต้องเติมคำว่า Bearer นำหน้า
# (ระบบเดิมที่ปิดไปแล้วใช้ X-IBM-Client-Id)
BOT_API_KEY_HEADER=Authorization

# timeout / retry / rate limit ของการเรียก BOT API
BOT_TIMEOUT_MS=8000
BOT_MAX_RETRIES=2
BOT_MAX_RPS=5

# ── Anthropic (ให้ที่ปรึกษา AI เรียบเรียงคำตอบด้วย Claude) ───────────────────
# ไม่ใส่ก็ได้ — ระบบจะใช้ตัวเรียบเรียงแบบกฎที่อ้างอิงผลลัพธ์จาก tool ชุดเดียวกัน
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── เซิร์ฟเวอร์ ──────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
SQLITE_PATH=apps/server/data/app.db

# ที่อยู่ที่เซิร์ฟเวอร์ผูก — ต้องเป็น 0.0.0.0 เมื่อรันในคอนเทนเนอร์
HOST=0.0.0.0

# origin ที่อนุญาตให้เรียกข้ามโดเมน
# ตอนพัฒนาหน้าเว็บอยู่คนละพอร์ตจึงต้องตั้ง; ตอน production เสิร์ฟจากโดเมนเดียวกัน
# จึงปล่อยว่างไว้ได้ (= ไม่เปิด CORS เลย)
CORS_ORIGIN=http://localhost:5173

# จำนวนชั้นของ reverse proxy ที่อยู่หน้าเซิร์ฟเวอร์ (Render/Fly/Cloud Run = 1)
# มีผลต่อการนับ IP ของตัวจำกัดอัตราคำขอ
TRUST_PROXY=0

# โฟลเดอร์หน้าเว็บที่ build แล้ว — ปกติระบบหาเจอเอง ตั้งเมื่อวางไว้คนละที่เท่านั้น
WEB_DIST_PATH=

# ── จำกัดอัตราคำขอ (จำเป็นเมื่อเปิดให้เข้าถึงสาธารณะ) ────────────────────────
# ตั้ง 0 เพื่อปิด
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
# เพดานแยกของ /api/advisor/chat และ /api/tools ซึ่งแพงกว่าเส้นทางอื่นมาก
RATE_LIMIT_EXPENSIVE_MAX=20

# ── MCP bridge (ไม่มี secret ใด ๆ — เรียกผ่าน backend เท่านั้น) ───────────────
MCP_API_BASE_URL=http://localhost:8787
